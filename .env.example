EMAIL=
PASSWORD=
API_KEY=
ROOT_USERNAME=
ROOT_PASSWORD=
ROOT_DATABASE=
MONGO_USER=
MONGO_PWD=
MONGO_DB_NAME=

# Redis — نفس القيمة بالضبط على الحسابات الأربعة (لازم يشتركون بنفس Redis)
REDIS_URL=redis://127.0.0.1:6379
# أقصى عدد رسائل بالثانية لكل حساب (ارفعها تدريجيًا لو ما فيه 429 بعد المراقبة)
SEND_RATE_PER_SECOND=1
# كم ثانية تفضل القناة "مكتومة" بعد أول 403 قبل ما يعاد تجربتها
SILENCE_TTL_SECONDS=300